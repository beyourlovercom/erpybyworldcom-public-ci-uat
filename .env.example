APP_NAME="YBY ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localerp.ybyworld.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
AUTH_REMEMBER_DURATION=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=2.0
REDIS_READ_TIMEOUT=6.0
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_BLOCK_FOR=5
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ERP_LOCAL_ADMIN_BYPASS=false
ERP_LOCAL_ADMIN_EMAIL=test@example.com

WOO_BASE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_CONNECTION_KEY=ybyworld.com
WOO_TIMEOUT_SECONDS=15
WOO_PRODUCT_SYNC_ENABLED=false
WOO_MEDIA_ALLOWED_HOSTS=

# Finance historical Woo settlement bootstrap. Keep false unless Owner approves Production apply.
ERP_ACCOUNTING_FINANCIAL_BOOTSTRAP_PRODUCTION_APPLY_ENABLED=false

# Andy Core / AffiliateWP connector
ANDY_CORE_URL=
ANDY_CORE_CONNECTION_KEY=ybyworld.com
ANDY_CORE_KEY_ID=
ANDY_CORE_SHARED_SECRET=
ANDY_CORE_TIMEOUT_SECONDS=15
ANDY_CORE_CONNECT_TIMEOUT_SECONDS=5
ANDY_CORE_RETRY_TIMES=2
ANDY_CORE_RETRY_SLEEP_MS=500
# Local/testing only. Never enable for production or use as live-provider evidence.
ANDY_CORE_UAT_FAKE=false

# Optional local YBY WordPress read-only intake source
YBY_WP_DB_HOST=127.0.0.1
YBY_WP_DB_PORT=3306
YBY_WP_DB_DATABASE=local
YBY_WP_DB_USERNAME=root
YBY_WP_DB_PASSWORD=
YBY_WP_DB_PREFIX=wp_

# Google Search Console read-only SEO connector
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_BASE_URL=https://www.googleapis.com/webmasters/v3
GSC_OAUTH_URL=https://oauth2.googleapis.com/token
GSC_TIMEOUT_SECONDS=20
GSC_ROW_LIMIT=25000
GSC_SYNC_ENABLED=false
GSC_SYNC_PROJECT=yby-irrigation
GSC_SYNC_SITE=ybyirrigation-com
GSC_SYNC_PROPERTY=sc-domain:ybyirrigation.com
GSC_SYNC_TIME=04:20
GSC_SYNC_TIMEZONE=Asia/Shanghai
GSC_SYNC_LOOKBACK_DAYS=7
GSC_SYNC_DATA_LAG_DAYS=2

GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REFRESH_TOKEN=
GA4_ACCESS_TOKEN=
GA4_ACCESS_TOKEN_FILE=
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=G-YKRXCX20TB
GA4_SYNC_ENABLED=false
GA4_SYNC_PROJECT=yby-irrigation
GA4_TIMEOUT_SECONDS=20
GA4_ROW_LIMIT=100000

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN_FILE=
YOUTUBE_SYNC_PROJECT=yby-irrigation
YOUTUBE_SYNC_CHANNEL=UCCdp_oR9MW_uPYOHf1qt0Qg
YOUTUBE_TIMEOUT_SECONDS=20


# Google Docs / Drive read bridge for Content Production V1.
# OAuth consent must include read-only Docs + Drive metadata scopes.
GOOGLE_DOCS_CLIENT_ID=
GOOGLE_DOCS_CLIENT_SECRET=
GOOGLE_DOCS_REFRESH_TOKEN=
GOOGLE_DOCS_API_BASE_URL=https://docs.googleapis.com/v1
GOOGLE_DRIVE_API_BASE_URL=https://www.googleapis.com/drive/v3
GOOGLE_DOCS_OAUTH_URL=https://oauth2.googleapis.com/token
GOOGLE_DOCS_TIMEOUT_SECONDS=20

# Content Production AI Editorial provider.
# Content Core depends only on EditorialAiClient; this adapter can be replaced later.
CONTENT_AI_PROVIDER=openai
CONTENT_AI_API_KEY=
CONTENT_AI_BASE_URL=https://api.openai.com/v1
CONTENT_AI_MODEL=gpt-5.6-terra
CONTENT_AI_TIMEOUT_SECONDS=90
CONTENT_AI_MAX_OUTPUT_TOKENS=12000
CONTENT_AI_PROXY=
